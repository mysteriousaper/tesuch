# Copy to .env.local (never commit real values). All services are free tiers.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the nightly job; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate: openssl rand -hex 32
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL=Tesuch <alerts@your-verified-domain>
# Optional. Support address for the owner-only "Invite Tesuch to set you up" card on the Team page. Card is hidden when unset.
# NEXT_PUBLIC_SUPPORT_EMAIL=
